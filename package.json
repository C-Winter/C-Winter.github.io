{
  "name": "c-winter.github.io",
  "version": "1.0.0",
  "description": "An organisation website",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css:mini": "postcss source/styles.css -o styles.css",
    "assets:copy": "cp source/*.svg .",
    "html:mini": "html-minifier --input-dir source --output-dir . --file-ext html --remove-comments --remove-empty-attributes --collapse-whitespace",
    "go": "npm run html:mini && npm run css:mini && npm run assets:copy",
    "preview": "browser-sync start --server --files '*.html, *.css, *.svg' --no-notify",
    "dev": "browser-sync start --server source --files 'source/**/*' --no-notify"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/C-Winter/C-Winter.github.io.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/C-Winter/C-Winter.github.io/issues"
  },
  "homepage": "https://github.com/C-Winter/C-Winter.github.io#readme",
  "dependencies": {
    "cssnano": "^5.0.17",
    "html-minifier": "^4.0.0",
    "postcss": "^8.5.32",
    "postcss-cli": "^9.1.0"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4"
  }
}
